<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="LifeLine – Hyperlocal Blood Donor Network. Find a matching blood donor near you, fast." />
    <title>@ViewData["Title"] - LifeLine</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🩸</text></svg>" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<nav class="navbar navbar-expand-lg navbar-dark bg-danger shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">&#10084; LifeLine</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link @(controller == "Requests" && action == "Index" ? "active" : "")" asp-controller="Requests" asp-action="Index"><i class="bi bi-droplet-fill"></i> Blood Requests</a></li>
                <li class="nav-item"><a class="nav-link @(controller == "Donors" ? "active" : "")" asp-controller="Donors" asp-action="Index"><i class="bi bi-people-fill"></i> Find Donors</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><a class="nav-link @(controller == "Requests" && action == "Create" ? "active" : "")" asp-controller="Requests" asp-action="Create"><i class="bi bi-plus-circle"></i> Post Request</a></li>
                    <li class="nav-item"><a class="nav-link @(controller == "Requests" && action == "My" ? "active" : "")" asp-controller="Requests" asp-action="My"><i class="bi bi-journal-text"></i> My Activity</a></li>
                }
            </ul>
            <ul class="navbar-nav align-items-lg-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><a class="nav-link @(controller == "Account" && action == "Profile" ? "active" : "")" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle"></i> @User.Identity!.Name</a></li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button class="btn btn-outline-light btn-sm ms-lg-2"><i class="bi bi-box-arrow-right"></i> Logout</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link @(controller == "Account" && action == "Login" ? "active" : "")" asp-controller="Account" asp-action="Login">Login</a></li>
                    <li class="nav-item"><a class="btn btn-light btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Register</a></li>
                }
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @RenderBody()
</main>

<footer class="text-center text-muted small py-3 border-top">
    <i class="bi bi-heart-fill text-danger"></i> LifeLine &ndash; Hyperlocal Blood Donor Network &middot; &copy; @DateTime.Now.Year
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.21.0/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
<script>
    // Disable submit buttons on form submit to prevent double-clicks
    document.querySelectorAll('form').forEach(form => {
        form.addEventListener('submit', function () {
            const btn = this.querySelector('button[type="submit"], button:not([type])');
            if (btn && !btn.classList.contains('btn-outline-secondary')) {
                setTimeout(() => {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Please wait...';
                }, 0);
            }
        });
    });
    // Auto-dismiss alerts after 5 seconds
    document.querySelectorAll('.alert-dismissible').forEach(alert => {
        setTimeout(() => {
            const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
            bsAlert.close();
        }, 5000);
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
