@model ProfileVm
@{
    ViewData["Title"] = "My Profile";
    var u = (AppUser)ViewBag.User;
}

<div class="row justify-content-center">
<div class="col-md-8 col-lg-6">
    <div class="alert @(u.IsEligible ? "alert-success" : "alert-warning") d-flex align-items-center">
        @if (u.IsEligible)
        {
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div><strong>You are eligible to donate.</strong> Thank you for being a lifesaver!</div>
        }
        else if (!u.IsDonor)
        {
            <i class="bi bi-person-x-fill me-2 fs-5"></i>
            <div><strong>You are not listed as a donor.</strong> Enable the option below to start helping.</div>
        }
        else
        {
            <i class="bi bi-clock-fill me-2 fs-5"></i>
            <div><strong>Cooldown active.</strong> You can donate again on @u.NextEligibleDate?.ToString("dd MMM yyyy").</div>
        }
    </div>
<div class="card shadow-sm"><div class="card-body p-4">
    <h3 class="mb-3"><i class="bi bi-person-gear text-danger"></i> My profile</h3>
    <form asp-action="Profile" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" maxlength="10" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="BloodGroup" class="form-label"></label>
                <select asp-for="BloodGroup" class="form-select" asp-items="@(new SelectList(BloodHelper.Groups))"></select>
                <span asp-validation-for="BloodGroup" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Area" class="form-label"></label>
                <input asp-for="Area" class="form-control" />
                <span asp-validation-for="Area" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="LastDonationDate" class="form-label"></label>
            <input asp-for="LastDonationDate" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="LastDonationDate" class="text-danger small"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsDonor" class="form-check-input" />
            <label asp-for="IsDonor" class="form-check-label"></label>
        </div>

        <button class="btn btn-danger"><i class="bi bi-check-lg"></i> Save changes</button>
    </form>
</div></div>
</div></div>
