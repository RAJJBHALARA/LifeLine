@model List<AppUser>
@{ ViewData["Title"] = "Find Donors"; }

<h3 class="mb-1"><i class="bi bi-people-fill text-danger"></i> Find eligible donors</h3>
<p class="text-muted">Only donors who are outside the @BloodHelper.CooldownDays-day cooldown are shown. Choose the blood group the patient <em>needs</em>; compatible donor groups are matched automatically.</p>

<form method="get" class="card card-body shadow-sm mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Blood group needed</label>
            <select name="group" class="form-select">
                <option value="">Any</option>
                @foreach (var g in BloodHelper.Groups)
                {
                    <option value="@g" selected="@(g == (string?)ViewBag.Group)">@g</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">City</label>
            <input name="city" class="form-control" value="@ViewBag.City" placeholder="e.g. Rajkot" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button class="btn btn-danger flex-fill"><i class="bi bi-search"></i> Search</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info"><i class="bi bi-info-circle"></i> No eligible donors found.</div>
}
else
{
<p class="text-muted small mb-2">Showing <strong>@Model.Count</strong> eligible donor(s)</p>
<div class="table-responsive">
<table class="table table-hover bg-white shadow-sm align-middle">
    <thead class="table-light"><tr><th>Name</th><th>Group</th><th>City / Area</th><th>Last donated</th><th>Contact</th></tr></thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td><i class="bi bi-person"></i> @d.FullName</td>
            <td><span class="blood-badge small">@d.BloodGroup</span></td>
            <td>@d.City@(string.IsNullOrEmpty(d.Area) ? "" : ", " + d.Area)</td>
            <td>@(d.LastDonationDate?.ToString("dd MMM yyyy") ?? "<span class='text-success'>Never</span>")</td>
            <td>
                @if (User.Identity?.IsAuthenticated == true) { <a href="tel:@d.Phone"><i class="bi bi-telephone"></i> @d.Phone</a> }
                else { <a asp-controller="Account" asp-action="Login"><i class="bi bi-lock"></i> Login to view</a> }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
}
