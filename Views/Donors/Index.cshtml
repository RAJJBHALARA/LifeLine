@model List<AppUser>
@{ 
    ViewData["Title"] = "Find Donors"; 
    string? selectedGroup = ViewBag.Group;
    List<string>? compatibleDonors = ViewBag.CompatibleDonors;
}

<div class="mb-3">
    <h3 class="mb-1"><i class="bi bi-people-fill text-danger"></i> Find Eligible Donors</h3>
    <p class="text-muted small mb-0">Search registered donors who are currently eligible to donate (outside the @BloodHelper.CooldownDays-day cooldown). Choose the blood group the patient <em>needs</em>; compatible donor groups are matched automatically.</p>
</div>

<form method="get" class="card card-body shadow-sm mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label mb-1">Blood group needed by patient</label>
            <select name="group" class="form-select">
                <option value="">Any Blood Group</option>
                @foreach (var g in BloodHelper.Groups)
                {
                    <option value="@g" selected="@(g == selectedGroup)">@g</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label mb-1">City</label>
            <input name="city" class="form-control" value="@ViewBag.City" placeholder="e.g. Rajkot, Surat" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-danger flex-fill"><i class="bi bi-search"></i> Search Donors</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(selectedGroup) && compatibleDonors != null)
    {
        <div class="small text-muted mt-2">
            <i class="bi bi-info-circle"></i> A patient with <strong>@selectedGroup</strong> can safely receive blood from donors of groups: 
            <strong>@string.Join(", ", compatibleDonors)</strong>.
        </div>
    }
</form>

@if (!Model.Any())
{
    <div class="alert alert-info"><i class="bi bi-info-circle"></i> No eligible donors found matching your search. Try broadening your city or group criteria.</div>
}
else
{
<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted small">Showing <strong>@Model.Count</strong> eligible donor(s)</span>
    <span class="badge text-bg-success"><i class="bi bi-shield-check"></i> All donors passed 90-day cooldown</span>
</div>
<div class="table-responsive">
<table class="table table-hover bg-white shadow-sm align-middle">
    <thead class="table-light"><tr><th>Name</th><th>Group</th><th>City / Area</th><th>Last Donated</th><th>Contact</th></tr></thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td><i class="bi bi-person-fill text-secondary me-1"></i> <strong>@d.FullName</strong></td>
            <td><span class="blood-badge small">@d.BloodGroup</span></td>
            <td>@d.City@(string.IsNullOrEmpty(d.Area) ? "" : ", " + d.Area)</td>
            <td>
                @if (d.LastDonationDate == null)
                {
                    <span class="text-success"><i class="bi bi-star-fill text-warning me-1"></i>Never (First time)</span>
                }
                else
                {
                    <span>@d.LastDonationDate.Value.ToString("dd MMM yyyy")</span>
                }
            </td>
            <td>
                @if (User.Identity?.IsAuthenticated == true) 
                { 
                    <a href="tel:@d.Phone" class="btn btn-sm btn-outline-danger"><i class="bi bi-telephone"></i> @d.Phone</a> 
                }
                else 
                { 
                    <a class="btn btn-sm btn-light border text-muted" asp-controller="Account" asp-action="Login"><i class="bi bi-lock-fill"></i> Login to view</a> 
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
}
